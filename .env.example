# OVARP Server API Keys
# Rename this file to .env and fill in your keys.
# Keys can also be set at runtime from the API Key Store tab; saving there
# writes them to provider_keys.yaml, encrypted when OVARP_SECRET_KEY is set.

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
ELEVENLABS_API_KEY=

# Optional security — both absent by default so a localhost run needs no setup.
# OVARP_ACCESS_TOKEN=            # required in the X-OVARP-Token header on /api/ calls
# OVARP_SECRET_KEY=              # encrypts stored provider credentials at rest

# Optional model selection. The defaults below are the cheapest current models
# that are good enough for a conversational agent; all are pinned ids. Avoid
# "-latest" aliases in a study: they can change underneath a running experiment.
# OVARP_GEMINI_LLM_MODEL=gemini-3.5-flash-lite
# OVARP_GEMINI_STT_MODEL=gemini-3.5-flash-lite
# OVARP_GEMINI_TTS_MODEL=gemini-3.8-flash-lite-tts
# OVARP_OPENAI_LLM_MODEL=gpt-6-luna
# OVARP_OPENAI_STT_MODEL=gpt-transcribe
# OVARP_OPENAI_TTS_MODEL=gpt-realtime-2.1-mini
# Reasoning effort for the OpenAI LLM calls (default: none, for conversational
# latency). Leave it empty for models that do not accept the parameter (gpt-4o).
# OVARP_OPENAI_REASONING_EFFORT=none
# Seconds a speech request may take before it is retried once (plus 50 ms per character).
# OVARP_TTS_TIMEOUT_S=15
