# OVARP Server API Keys
# Rename this file to .env and fill in your keys.
# Keys can also be set at runtime from the API Key Store tab; saving there
# writes them to provider_keys.yaml, encrypted when OVARP_SECRET_KEY is set.

OPENAI_API_KEY=sk-...
GEMINI_API_KEY=AIzaSy...
ELEVENLABS_API_KEY=

# Optional security — both absent by default so a localhost run needs no setup.
# OVARP_ACCESS_TOKEN=            # required in the X-OVARP-Token header on /api/ calls
# OVARP_SECRET_KEY=              # encrypts stored provider credentials at rest

# Optional model selection. Pin exact versions for a study, since "-latest"
# aliases can change underneath a running experiment.
# OVARP_GEMINI_LLM_MODEL=gemini-flash-latest
# OVARP_GEMINI_STT_MODEL=gemini-flash-latest
# OVARP_GEMINI_TTS_MODEL=gemini-3.1-flash-tts-preview
# OVARP_OPENAI_LLM_MODEL=gpt-4o
# OVARP_OPENAI_STT_MODEL=whisper-1
# OVARP_OPENAI_TTS_MODEL=tts-1
